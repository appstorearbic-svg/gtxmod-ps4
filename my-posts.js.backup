// GTXMOD — منشوراتي
(function(){
const $=id=>document.getElementById(id),E=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const CATS=["سيارات","طيارات","موطورات","قوارب","شخصيات","مابات","سكربتات"];let cat="سيارات",thumb="";
const st=document.createElement("style");st.textContent=`#mpPage{position:fixed;inset:0;z-index:10004;display:none;overflow-y:auto;direction:rtl;color:#fff;background:radial-gradient(1100px 560px at 88% -8%,#0e2a52,transparent 60%),radial-gradient(900px 520px at -12% 112%,#132244,transparent 55%),#050d1c}#mpPage::-webkit-scrollbar,.mp-form::-webkit-scrollbar{width:9px}#mpPage::-webkit-scrollbar-thumb,.mp-form::-webkit-scrollbar-thumb{background:linear-gradient(#087bd0,#60a5fa);border-radius:8px}#mpPage::-webkit-scrollbar-track,.mp-form::-webkit-scrollbar-track{background:#071a30}.mp-wrap{max-width:620px;margin:0 auto;padding:0 16px 90px}.mp-head{display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:5;padding:16px 0 12px;background:#050d1ce8;backdrop-filter:blur(8px);border-bottom:1px solid #1c3a63}.mp-back{width:40px;height:40px;border-radius:50%;border:1px solid #2874bd;background:#0d2547;color:#60a5fa;font-size:19px}.mp-title{font-size:22px;font-weight:800;background:linear-gradient(90deg,#60a5fa,#38d9f5);-webkit-background-clip:text;background-clip:text;color:transparent}.mp-count{margin-inline-start:auto;background:#0d2547;border:1px solid #2874bd;color:#8bbce8;padding:6px 14px;border-radius:20px;font-size:13px;white-space:nowrap}.mp-card{display:flex;gap:12px;background:linear-gradient(160deg,#0f2038,#0b1830);border:1px solid #1e406e;border-radius:14px;padding:12px;margin:12px 0;animation:mpIn .35s ease both}.mp-thumb{width:86px;height:86px;border-radius:10px;object-fit:cover;background:#12233d;flex:0 0 auto}.mp-name{font-weight:700;font-size:16px;overflow-wrap:anywhere}.mp-chip{display:inline-block;background:#087bd022;border:1px solid #087bd0;color:#60a5fa;padding:2px 10px;border-radius:12px;font-size:12px;margin:4px 0}.mp-meta{color:#7fa8d4;font-size:12px}.mp-dl,.mp-del{padding:7px 12px;border-radius:8px;font-size:13px;text-decoration:none;border:0}.mp-dl{background:#087bd0;color:#fff}.mp-del{background:#3a1520;color:#f87171;border:1px solid #7f1d1d}.mp-empty{text-align:center;padding:44px 0 10px;animation:mpIn .4s ease both}.mp-zero{font-size:70px;font-weight:900;line-height:1;background:linear-gradient(180deg,#60a5fa,#1d4ed8);-webkit-background-clip:text;background-clip:text;color:transparent}.mp-plus{width:100%;padding:24px;margin-top:16px;background:#087bd012;border:2px dashed #2874bd;border-radius:16px;color:#60a5fa;font-size:42px;line-height:1}.mp-plus:hover{background:#087bd026;border-color:#60a5fa;box-shadow:0 0 26px #087bd055}#mpSheet{position:fixed;inset:0;z-index:10005;display:none;align-items:center;justify-content:center;background:#000c;padding:16px}.mp-form{width:100%;max-width:440px;max-height:92vh;overflow-y:auto;background:linear-gradient(170deg,#0e1e38,#0a1628);border:1px solid #2874bd;border-radius:18px;padding:20px;box-sizing:border-box;animation:mpIn .25s ease both}.mp-form h2{margin:0 0 14px;font-size:20px}.mp-form label{color:#8bbce8;font-size:13px}.mp-in{width:100%;padding:12px;background:#071a30;border:1px solid #1e406e;border-radius:10px;color:#fff;box-sizing:border-box;margin:6px 0 12px;font-family:inherit}.mp-in:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px #087bd033}.mp-cats{display:flex;flex-wrap:wrap;gap:7px;margin:6px 0 12px}.mp-cat{padding:8px 14px;border-radius:20px;background:#071a30;border:1px solid #1e406e;color:#8bbce8;font-size:13px}.mp-cat.on{background:linear-gradient(90deg,#087bd0,#2563eb);color:#fff;border-color:#60a5fa}.mp-file{display:block;border:1.5px dashed #2874bd;border-radius:12px;padding:14px;text-align:center;color:#8bbce8;margin:6px 0 12px;font-size:14px}.mp-file.ok{border-color:#22c55e;color:#4ade80}.mp-bar{height:8px;background:#071a30;border-radius:6px;overflow:hidden;margin:10px 0;display:none}.mp-fill{height:100%;width:0;background:linear-gradient(90deg,#087bd0,#22c55e);transition:width .2s}.mp-go{width:100%;padding:14px;background:linear-gradient(90deg,#087bd0,#2563eb);border:0;border-radius:12px;color:#fff;font-size:17px;font-weight:700}.mp-go:disabled{opacity:.55}.mp-x{width:100%;padding:11px;margin-top:8px;background:#263d59;color:#fff;border:0;border-radius:10px}#mpToast{position:fixed;bottom:22px;right:50%;transform:translateX(50%);z-index:10007;background:#0d2547;border:1px solid #22c55e;color:#fff;padding:12px 20px;border-radius:12px;display:none;box-shadow:0 8px 30px #000a;max-width:90vw;text-align:center}@keyframes mpIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}`;
document.head.appendChild(st);
const mb=document.createElement("button");mb.id="mpOpen";mb.textContent="📁 منشوراتي";mb.style.cssText="width:100%;padding:12px;margin-top:8px;background:linear-gradient(90deg,#1769aa,#087bd0);color:#fff;border:0;border-radius:9px;font-size:15px";$("accountSettingsOpen").after(mb);
const page=document.createElement("div");page.id="mpPage";page.innerHTML=`<div class="mp-wrap"><div class="mp-head"><button class="mp-back" id="mpBack">→</button><div class="mp-title">📁 منشوراتي</div><span class="mp-count" id="mpCount">…</span></div><div id="mpList"></div><button class="mp-plus" id="mpPlus">+</button></div>`;document.body.appendChild(page);
const sh=document.createElement("div");sh.id="mpSheet";sh.innerHTML=`<div class="mp-form"><h2>🚀 نشر مود جديد</h2><label>اسم المود</label><input class="mp-in" id="mpName" maxlength="60" placeholder="مثال: BMW M5"><label>تصنيف المود</label><div class="mp-cats" id="mpCats"></div><label>وصف المود</label><textarea class="mp-in" id="mpDesc" rows="3" maxlength="600" placeholder="تفاصيل المود"></textarea><label>ملف المود ZIP (حد 20MB)</label><label class="mp-file" id="mpZipBox">📦 اضغط لاختيار ملف ZIP<input id="mpZip" type="file" accept=".zip,application/zip" hidden></label><label>صورة المود</label><label class="mp-file" id="mpImgBox">🖼 اضغط لاختيار صورة<input id="mpImg" type="file" accept="image/*" hidden></label><img id="mpPrev" style="display:none;width:100%;max-height:170px;object-fit:cover;border-radius:10px;margin-bottom:12px"><div class="mp-bar" id="mpBar"><div class="mp-fill" id="mpFill"></div></div><button class="mp-go" id="mpGo">🚀 نشر..</button><button class="mp-x" id="mpClose">إغلاق</button><p id="mpMsg" style="min-height:18px;margin:10px 0 0;color:#8bbce8;font-size:13px"></p></div>`;document.body.appendChild(sh);
const tt=document.createElement("div");tt.id="mpToast";document.body.appendChild(tt);
const toast=t=>{tt.textContent=t;tt.style.display="block";clearTimeout(tt._t);tt._t=setTimeout(()=>tt.style.display="none",3500)};
$("mpCats").innerHTML=CATS.map(c=>`<button type="button" class="mp-cat${c===cat?" on":""}" data-c="${c}">${c}</button>`).join("");
$("mpCats").onclick=e=>{const b=e.target.closest(".mp-cat");if(!b)return;cat=b.dataset.c;document.querySelectorAll(".mp-cat").forEach(x=>x.classList.toggle("on",x===b))};
const card=m=>`<div class="mp-card"><img class="mp-thumb" src="${E(m.image||"logo.jpg")}"><div style="flex:1;min-width:0"><div class="mp-name">${E(m.name)}</div><span class="mp-chip">#${E(m.category)}</span><div class="mp-meta">⇩ ${E(m.size)} • ${E(m.date)}</div><div style="display:flex;gap:8px;margin-top:8px"><a class="mp-dl" href="${E(m.download)}" download>⬇ تحميل</a><button class="mp-del" data-id="${E(m.id)}">🗑 حذف</button></div></div></div>`;
async function load(){$("mpList").innerHTML='<div class="mp-empty" style="color:#8bbce8">جاري التحميل...</div>';try{const r=await fetch("/api/community?mine=1",{credentials:"same-origin"}),d=await r.json();if(!d.success)throw new Error(d.message||"سجل دخول أولاً.");$("mpCount").textContent=d.mods.length+" منشور";$("mpList").innerHTML=d.mods.length?d.mods.map(card).join(""):'<div class="mp-empty"><div class="mp-zero">0</div><div style="color:#8bbce8;font-size:17px;margin:10px 0 4px">ما عندك منشورات بعد</div><div style="color:#5d84ad;font-size:13px">اضغط + وانشر أول مود إلك 🚀</div></div>'}catch(e){$("mpCount").textContent="0 منشور";$("mpList").innerHTML='<div class="mp-empty" style="color:#f87171">'+E(e.message)+'</div>'}}
mb.onclick=()=>{if(typeof gtxGoogleUser==="undefined"||!gtxGoogleUser){if(typeof showGoogleLogin==="function")showGoogleLogin();return}$("accountPanel").style.display="none";page.style.display="block";document.body.style.overflow="hidden";load()};
$("mpBack").onclick=()=>{page.style.display="none";document.body.style.overflow=""};
$("mpPlus").onclick=()=>{sh.style.display="flex";$("mpMsg").textContent=""};
$("mpClose").onclick=()=>sh.style.display="none";
$("mpZip").onchange=e=>{const f=e.target.files[0],b=$("mpZipBox");if(!f)return;if(f.size>20971520){b.classList.remove("ok");b.childNodes[0].textContent="❌ أكبر من 20MB";e.target.value="";return}b.classList.add("ok");b.childNodes[0].textContent="✅ "+f.name+" ("+(f.size/1048576).toFixed(1)+"MB)"};
$("mpImg").onchange=e=>{const f=e.target.files[0];if(!f)return;const i=new Image();i.onload=()=>{const m=Math.min(i.width,i.height),c=document.createElement("canvas");c.width=c.height=400;c.getContext("2d").drawImage(i,(i.width-m)/2,(i.height-m)/2,m,m,0,0,400,400);thumb=c.toDataURL("image/jpeg",.78);$("mpPrev").src=thumb;$("mpPrev").style.display="block";$("mpImgBox").classList.add("ok");$("mpImgBox").childNodes[0].textContent="✅ "+f.name;URL.revokeObjectURL(i.src)};i.onerror=()=>$("mpMsg").textContent="ما كدرنا نقرا الصورة.";i.src=URL.createObjectURL(f)};
$("mpGo").onclick=()=>{const n=$("mpName").value.trim(),z=$("mpZip").files[0],im=$("mpImg").files[0],msg=$("mpMsg");if(n.length<2)return msg.textContent="اكتب اسم المود.";if(!z)return msg.textContent="اختار ملف ZIP.";if(!im)return msg.textContent="اختار صورة للمود.";const fd=new FormData();fd.append("name",n);fd.append("category",cat);fd.append("description",$("mpDesc").value.trim());fd.append("thumb",thumb);fd.append("image",im);fd.append("zip",z);const x=new XMLHttpRequest();x.open("POST","/api/community");x.withCredentials=true;$("mpGo").disabled=true;$("mpBar").style.display="block";msg.textContent="جاري الرفع...";x.upload.onprogress=ev=>{if(ev.lengthComputable){const p=Math.round(ev.loaded/ev.total*100);$("mpFill").style.width=p+"%";msg.textContent="جاري الرفع "+p+"%"}};x.onload=()=>{$("mpGo").disabled=false;let d={};try{d=JSON.parse(x.responseText)}catch(e){}if(x.status>=200&&x.status<300&&d.success){sh.style.display="none";toast("✅ "+(d.message||"تم النشر!"));$("mpName").value="";$("mpDesc").value="";$("mpZip").value="";$("mpImg").value="";thumb="";$("mpPrev").style.display="none";$("mpFill").style.width="0";$("mpBar").style.display="none";$("mpZipBox").classList.remove("ok");$("mpZipBox").childNodes[0].textContent="📦 اضغط لاختيار ملف ZIP";$("mpImgBox").classList.remove("ok");$("mpImgBox").childNodes[0].textContent="🖼 اضغط لاختيار صورة";load();window.gtxLoadCommunity&&window.gtxLoadCommunity()}else msg.textContent=d.message||"فشل النشر ("+x.status+")"};x.onerror=()=>{$("mpGo").disabled=false;msg.textContent="تعذر الاتصال — حاول ثانية."};x.send(fd)};
$("mpList").onclick=async e=>{const b=e.target.closest(".mp-del");if(!b||!confirm("متأكد تريد حذف المنشور؟"))return;b.textContent="...";try{const r=await fetch("/api/community",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"delete",id:b.dataset.id})}),d=await r.json();if(!d.success)throw new Error(d.message||"فشل الحذف");toast("🗑 تم الحذف");load();window.gtxLoadCommunity&&window.gtxLoadCommunity()}catch(err){toast("❌ "+err.message);b.textContent="🗑 حذف"}};
window.gtxLoadCommunity=async()=>{try{const r=await fetch("/api/community"),d=await r.json();if(!d.success||!Array.isArray(d.mods))return;const ids=new Set(mods.map(m=>m.id));d.mods.forEach(m=>{if(!ids.has(m.id))mods.push(m)});render()}catch(e){}};
})();
